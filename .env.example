# Base URL of the Nenggala backend API (backend-nenggala), including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Origin that serves uploaded files (the backend's Uploads/ directory).
# Backend-returned image paths (e.g. "Uploads/Content/x.jpg") are resolved against this.
NEXT_PUBLIC_API_FILE_BASE_URL=http://localhost:5000
